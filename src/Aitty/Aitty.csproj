<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <AssemblyName>Aitty</AssemblyName>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <!-- 원격 서버에서 실행될 logcheck.sh를 어셈블리에 임베드 (LogCheckService에서 GetManifestResourceStream으로 로드) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\logcheck.sh">
      <LogicalName>Aitty.Resources.logcheck.sh</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 위험명령 패턴 정책 SoT — webapp/policies/command-safety.json을 임베드
       (프론트와 동일 파일 공유. CommandSafetyService에서 GetManifestResourceStream으로 로드) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\webapp\policies\command-safety.json">
      <LogicalName>Aitty.Resources.command-safety.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- dotnet build/publish 전 React 자동 빌드 + wwwroot 동기화 -->
  <Target Name="BuildReactApp" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildThisFileDirectory)..\..\webapp\package.json') AND '$(SkipReactBuild)' != 'true'">
    <PropertyGroup>
      <WebappDir>$(MSBuildThisFileDirectory)..\..\webapp</WebappDir>
      <WwwrootDir>$(MSBuildThisFileDirectory)wwwroot</WwwrootDir>
    </PropertyGroup>

    <Message Text="[Aitty] npm run build → $(WebappDir)" Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(WebappDir)" />

    <Message Text="[Aitty] dist → wwwroot 동기화" Importance="high" />
    <Exec Command="robocopy &quot;$(WebappDir)\dist&quot; &quot;$(WwwrootDir)&quot; /MIR /NJH /NJS /NDL /NC /NS" IgnoreExitCode="true" />

    <!-- WebView2 가상호스트 매핑에서 crossorigin 속성은 스크립트 로드를 차단하므로 빌드 시 제거
         (런타임 수정은 Program Files 등 읽기 전용 위치 설치 시 실패) -->
    <Message Text="[Aitty] index.html crossorigin 속성 제거" Importance="high" />
    <Exec Command="powershell -NoProfile -Command &quot;$f='$(WwwrootDir)\index.html'; if (Test-Path $f) { (Get-Content $f -Raw -Encoding UTF8) -replace ' crossorigin','' | Set-Content $f -NoNewline -Encoding UTF8 }&quot;" IgnoreExitCode="true" />
  </Target>

  <!-- React 빌드 후 wwwroot 파일을 동적으로 Content에 등록 (BeforeBuild 이후 평가) -->
  <Target Name="IncludeWwwroot" AfterTargets="BuildReactApp" BeforeTargets="BeforeCompile">
    <ItemGroup>
      <Content Include="wwwroot\**\*" Condition="Exists('$(MSBuildThisFileDirectory)wwwroot')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

</Project>
